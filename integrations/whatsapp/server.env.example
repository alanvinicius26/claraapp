# Server/Supabase secrets only. NEVER add VITE_ to these names.
# Supabase supplies these two values to deployed Edge Functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Existing booking gateway also requires the matching public application key:
APP_PUBLISHABLE_KEY=
APP_ORIGIN=
CLARA_N8N_SECRET=
WHATSAPP_MODE=simulation
WHATSAPP_LIVE_ENABLED=false
# Not required by the isolated local simulator:
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# Per-business onboarding. No shared META_ACCESS_TOKEN is used by the Edge Function.
META_APP_ID=
META_SIGNUP_CONFIG_ID=
META_ONBOARDING_ENABLED=false
META_SIGNUP_COEXISTENCE=false
# 32 cryptographically random bytes, encoded as 64 hexadecimal characters.
# Keep backups securely; changing this value requires re-encryption/reconnection.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Optional HTTPS wake-up webhook for n8n. Periodic processing is the fallback.
N8N_WAKE_URL=
